{
  "name": "smart-elimu",
  "version": "1.0.0",
  "private": true,
  "description": "SMART-ELIMU — Plateforme congolaise d'éducation : formation certifiante en ligne, gestion d'établissement scolaire et orientation scolaire & académique, en partenariat avec les universités et centres de formation agréés.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:setup": "tsx scripts/seed.ts",
    "db:seed": "tsx scripts/seed.ts --keep",
    "db:reset": "rm -f data/smart-elimu.db data/smart-elimu.db-wal data/smart-elimu.db-shm && tsx scripts/seed.ts",
    "db:shell": "tsx scripts/shell.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
